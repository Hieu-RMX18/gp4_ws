# Copy this file to .env and set the real secret locally.
# Do not commit the generated .env file.
GP4_LLM_API_KEY=replace_with_real_api_key

# Shared HMI -> llm_gateway ReviewIntent signing secret.
# Required for all ReviewIntent calls. The HMI sends an HMAC-bound proof, not
# this raw value, so both processes must load the same secret.
GP4_REVIEW_INTENT_TOKEN=replace_with_random_review_token

# Hardware execution stays disabled unless an approved commissioning session
# explicitly sets both variables below. Keep the committed gate JSON locked.
# HMI_ENABLE_HARDWARE_COMMANDS=0
# HMI_HARDWARE_GATE_EVIDENCE_FILE=/home/hieu2/gp4_ws/hmi/data/hardware_gate.local.json

# Shell setup for this workspace belongs in your terminal profile, not in git:
# export GP4_LLM_ENV_FILE=/home/hieu2/gp4_ws/.env
# export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# export ROS_DOMAIN_ID=39
