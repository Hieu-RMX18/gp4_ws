<?xml version="1.0"?>
<package format="3">
  <name>gp4_bringup</name>
  <version>0.0.1</version>
  <description>Bringup launch files for GP4 MoveIt</description>

  <maintainer email="msrgentleman@gmail.com">hieu2</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>moveit_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>gp4_moveit_config</exec_depend>
  <exec_depend>gp4_station</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>trac_ik_kinematics_plugin</exec_depend>
  <exec_depend>motion_core</exec_depend>
  <exec_depend>hw_adapter</exec_depend>
  <exec_depend>llm_gateway</exec_depend>
  <exec_depend>safety</exec_depend>
  <exec_depend>supervisor</exec_depend>
  <exec_depend>diagnostic_aggregator</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
