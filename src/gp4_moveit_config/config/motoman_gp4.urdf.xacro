<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="motoman_gp4">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />
    <!-- 
        use_fake_hardware:
          true  = simulation/mock (mặc định an toàn)
          false = robot thật Yaskawa GP4 qua MotoROS2
    -->
    <xacro:arg name="use_fake_hardware"       default="true" />
    <xacro:arg name="robot_ip"                default="192.168.1.33" />
    <xacro:arg name="controller_port"         default="50240" />

    <!-- Import motoman_gp4 urdf file -->
    <xacro:include filename="$(find motoman_gp4_support)/urdf/gp4.xacro" />

    <!-- TCP Link configuration: 11cm (0.11m) from tool0 -->
    <link name="tcp_link" />
    <joint name="tool0_to_tcp" type="fixed">
      <parent link="tool0" />
      <child link="tcp_link" />
      <origin xyz="0.05 0 0.115" rpy="0 0 0" />
    </joint>

    <!-- Import ros2_control xacro -->
    <xacro:include filename="motoman_gp4.ros2_control.xacro" />

    <!--
      Station visual is embedded in MoveIt robot_description so gp4_bringup
      always shows the real cell model in RViz.
      Collision authority stays in gp4_bringup/config/scene_objects.yaml.
    -->
    <link name="station_visual_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://gp4_station/meshes/station3.stl" scale="0.001 0.001 0.001" />
        </geometry>
        <material name="station_grey">
          <color rgba="0.35 0.35 0.35 1.0" />
        </material>
      </visual>
    </link>

    <joint name="base_to_station_visual" type="fixed">
      <parent link="base_link" />
      <child link="station_visual_link" />
      <origin xyz="0 0 0" rpy="0 0 ${pi}" />
    </joint>

    <!-- Gọi macro với tham số thật/giả -->
    <xacro:motoman_gp4_ros2_control
        name="GP4RealSystem"
        initial_positions_file="$(arg initial_positions_file)"
        use_fake_hardware="$(arg use_fake_hardware)"
        robot_ip="$(arg robot_ip)"
        controller_port="$(arg controller_port)"
    />
</robot>
