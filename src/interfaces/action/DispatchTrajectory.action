# Goal — validated JointTrajectory dispatched from motion_core to hw_adapter.
# hw_adapter is the only node allowed to send it to the robot controller.
trajectory_msgs/JointTrajectory trajectory
float64 timeout_sec          # execution timeout; 0 = use hw_adapter default
string command_id
string primitive
string planner_id
builtin_interfaces/Time source_joint_state_stamp
float64[] expected_start_positions
bool enforce_start_state_match
---
# Result
bool success
string message
float64 execution_time_sec
string failure_stage
int32 controller_error_code
string controller_error_name
string controller_error_string
float64 max_start_state_abs_delta
float64 start_state_l2_delta
---
# Feedback
string state                 # e.g. "readiness_check", "trajectory_mode", "executing", "done"
