# Goal
string primitive_type        # "LIN", "PTP", "CIRC", "HOME", "MOVE_REL", "approach", "retract"
geometry_msgs/Pose target_pose
float64[] joint_target       # optional, dùng cho PTP joint-space
float64 velocity_scale       # 0.0 - 1.0
float64 acceleration_scale   # 0.0 - 1.0
string planner_id            # "PILZ_LIN", "PILZ_PTP", "OMPL_RRTConnect"
bool require_approval        # true = chờ human confirm trước khi execute
# MOVE_REL: translation-only relative motion (Step 2)
float64 delta_x              # relative translation in meters (base_link frame)
float64 delta_y              # relative translation in meters (base_link frame)
float64 delta_z              # relative translation in meters (base_link frame)
string reference_frame       # only "base_link" supported; empty defaults to base_link
# --- WAIT ---
float64 wait_duration_sec    # seconds to pause before next motion
# --- MOVE_JOINT ---
int32 joint_index            # 0-based joint index (0..5 for GP4)
float64 joint_angle          # target angle in radians
# --- IO_SET ---
uint32 io_address            # controller I/O address
int32 io_value               # value to write (0 or 1 for digital)
---
# Result
bool success
string message
float64 execution_time_sec
---
# Feedback
float64 progress             # 0.0 - 1.0
string current_state
